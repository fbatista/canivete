<tr
  id="<%= dom_id(event_participant) %>"
  class="<%= event_participant.playing? ? "" : "line-through" %> odd:bg-white odd:dark:bg-gray-900 even:bg-gray-50 even:dark:bg-gray-800 border-b dark:border-gray-700"
>
  <% case @tournament.state %>
  <% when 'registration_open', 'registration_closed' %>
    <th
      scope="row"
      data-tooltip-target="tooltip-<%= event_participant.id %>"
      class="
        px-5 py-4 font-medium text-gray-900 whitespace-nowrap
        dark:text-white
      "
    >
      <%= truncate(event_participant.name) %>
    </th>
  <% else %>
    <th
      scope="row"
      class="
        px-5 py-4 text-center font-medium text-gray-900 whitespace-nowrap
        dark:text-white
      "
    >
      <%= event_participant.rank %>
    </th>
    <th
      scope="row"
      data-tooltip-target="tooltip-<%= event_participant.id %>"
      class="
        px-5 py-4 font-medium text-gray-900 whitespace-nowrap
        dark:text-white
      "
    >
      <%= truncate(event_participant.name) %>
    </th>
    <td class="px-5 py-4"><%= event_participant.match_points %></td>
    <td class="px-5 py-4">
      <%= (event_participant.match_win_percentage * 100).round(2) %>%
    </td>
    <td class="px-5 py-4">
      <%= (event_participant.opponents_average_match_win_percentage * 100).round(2) %>%
    </td>
    <td class="px-5 py-4">
      <%= event_participant.opponents_average_match_points %>
    </td>
    <td class="px-5 py-4 text-nowrap">
      <%= event_participant.number_of_wins -%>
      &nbsp;-&nbsp;
      <%= event_participant.number_of_losses -%>
      &nbsp;-&nbsp;
      <%= event_participant.number_of_draws -%>
    </td>
  <% end %>
  <% if @layout_mode == "application" %>
    <td scope="col" class="px-5 py-3">
      <% if event_participant.number_of_infractions > 0 %>
        <%= link_to [:organizer, event_participant.tournament, event_participant, :infractions], data: { turbo_frame: "modal" }, class: "inline-flex items-center px-5 py-2.5 text-sm font-medium text-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" do %>
          View
          <span
            class="
              inline-flex items-center justify-center w-4 h-4 ms-2 text-xs
              font-semibold text-blue-800 bg-blue-200 rounded-full
            "
          >
            <%= event_participant.number_of_infractions %>
          </span>
        <% end %>
      <% else %>
        -
      <% end %>
    </td>
    <td scope="col" class="px-5 py-3 text-right">
      <div class="inline-flex items-center">
        <%= link_to [:new, :organizer, @tournament, :infraction, { player_id: event_participant.player_id }], data: { turbo_frame: "modal" }, class: "text-white bg-red-700 hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300 font-medium rounded-full text-sm px-5 py-2.5 text-center me-2 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-900" do %>
          <%= icon("gavel", class: "me-2") %>
          Record Infraction
        <% end %>

        <% if event_participant.playing? %>
          <%= button_to [:organizer, @tournament, event_participant], params: { event_participant: { dropped: true } }, data: { turbo_confirm: "Are you sure you wish to drop #{event_participant.name}?" }, class: "text-white bg-red-700 hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300 font-medium rounded-full text-sm px-5 py-2.5 text-center me-2 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-900" do %>
            <%= icon("user-minus", class: "me-2") %>
            Drop
          <% end %>
        <% else %>
          <%= button_to [:organizer, @tournament, event_participant], params: { event_participant: { dropped: false } }, data: { turbo_confirm: "Are you sure you wish to re-enroll #{event_participant.name}?" }, class: "text-white bg-green-700 hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-full text-sm px-5 py-2.5 text-center me-2 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-900" do %>
            <%= icon("user-plus", class: "me-2") %>
            Undo Drop
          <% end %>
        <% end %>

        <% if event_participant.checked_in? %>
          <%= button_to [:organizer, @tournament, event_participant], params: { event_participant: { checked_in: false } }, class: "text-white bg-gray-700 hover:bg-gray-800 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-full text-sm px-5 py-2.5 text-center me-2 dark:bg-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-900" do %>
            <%= icon("x", class: "me-2") %>
            Undo Check-in
          <% end %>
        <% else %>
          <%= button_to [:organizer, @tournament, event_participant], params: { event_participant: { checked_in: true } }, class: "text-white bg-green-700 hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-full text-sm px-5 py-2.5 text-center me-2 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-900" do %>
            <%= icon("check", class: "me-2") %>
            Check-in
          <% end %>
        <% end %>

        <% if event_participant.paid? %>
          <%= button_to [:organizer, @tournament, event_participant], params: { event_participant: { paid: false } }, class: "text-white bg-gray-700 hover:bg-gray-800 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-full text-sm px-5 py-2.5 text-center me-2 dark:bg-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-900" do %>
            <%= icon("x", class: "me-2") %>
            Undo Paid
          <% end %>
        <% else %>
          <%= button_to [:organizer, @tournament, event_participant], params: { event_participant: { paid: true } }, class: "text-white bg-green-700 hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-full text-sm px-5 py-2.5 text-center me-2 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-900" do %>
            <%= icon("check", class: "me-2") %>
            Paid
          <% end %>
        <% end %>
      </div>
    </td>
  <% end %>
  <div
    id="tooltip-<%= event_participant.id %>"
    role="tooltip"
    class="
      absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium
      text-white transition-opacity duration-300 bg-gray-900 rounded-lg
      shadow-sm opacity-0 tooltip dark:bg-gray-700
    "
  >
    <%= event_participant.name %>
    <br>

    <%= event_participant.obfuscated_key %>
    <div class="tooltip-arrow" data-popper-arrow="true"></div>
  </div>
</tr>
