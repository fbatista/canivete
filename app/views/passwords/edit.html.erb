<%= modal_form_for :password, url: password_path(params[:token]), html: { id: "password-reset-form", method: "put" } do |f| %>
  <% content_for :title do %>
    Update your password
  <% end %>

  <% if alert = flash[:alert] %>
    <div class="mb-4 p-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400" role="alert">
      <%= alert %>
    </div>
  <% end %>

  <%= f.password_field_with_label :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72 %>
  <%= f.password_field_with_label :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72 %>

  <% content_for :footer do %>
    <%= f.submit "Save", class: "text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" %>
  <% end %>
<% end %>
