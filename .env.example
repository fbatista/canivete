# Database connection configuration
#
# The application supports two ways of connecting to PostgreSQL, controlled
# by whether DB_HOST is set (see config/database.yml). Copy this file to
# .env / .env.local / .env.test and fill in your values.

# ---------------------------------------------------------------------------
# Option 1 (recommended for tests/CI): connect via TCP
#
# Set DB_HOST to enable TCP. When set, config/database.yml connects with
# the hardcoded postgres/postgres credentials over the network, instead of
# relying on the local socket. More akin to a real production environment.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Option 2: connect via the local Unix socket as the current OS user
#
# Leave DB_HOST unset (commented out) to use socket auth. libpq authenticates
# as the OS username running Rails, so no credentials are required — fine for
# local development.
#
# # DB_HOST=
#
# Optionally override the role used over the socket with PGUSER, e.g. a
# dedicated postgres superuser instead of your OS account:
# PGUSER=postgres
# ---------------------------------------------------------------------------
